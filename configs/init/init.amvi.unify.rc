on early-init && property:ro.boot.em.model=SM-M346B1
    # Firmware blobs
    mount none /vendor/firmware/SM-M346B1/mfc_fw.bin /vendor/firmware/mfc_fw.bin bind
    mount none /vendor/firmware/SM-M346B1/NPU.bin /vendor/firmware/NPU.bin bind
