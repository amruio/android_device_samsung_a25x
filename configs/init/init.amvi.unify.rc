    # TEEgris
    mount none /vendor/tee/SM-M346B2 /vendor/tee bind

on post-fs-data && property:ro.product.system.device=m34x
stop hermesd
stop vendor.hermes-default

# Restart just to be safe.
on boot
    restart audioserver
