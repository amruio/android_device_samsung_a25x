# a25zhx (chn_open)
on early-init && property:ro.boot.em.model=SM-A2560
    # Firmware blobs
    mount none /vendor/firmware/SM-A2560/AP_AUDIO_SLSI.bin /vendor/firmware/AP_AUDIO_SLSI.bin bind
    mount none /vendor/firmware/SM-A2560/APDV_AUDIO_SLSI.bin /vendor/firmware/APDV_AUDIO_SLSI.bin bind
    mount none /vendor/firmware/SM-A2560/mfc_fw.bin /vendor/firmware/mfc_fw.bin bind
    mount none /vendor/firmware/SM-A2560/NPU.bin /vendor/firmware/NPU.bin bind
    mount none /vendor/firmware/SM-A2560/os.checked.bin /vendor/firmware/os.checked.bin bind
    mount none /vendor/firmware/SM-A2560/vts.bin /vendor/firmware/vts.bin bind
    mount none /vendor/firmware/SM-A2560/calliope_sram.bin /vendor/firmware/calliope_sram.bin bind
    # TEEgris
    mount none /vendor/tee/SM-A2560 /vendor/tee bind

# a25xxx (eur_open)
on early-init && property:ro.boot.em.model=SM-A256B
    # Firmware blobs
    mount none /vendor/firmware/SM-A256B/AP_AUDIO_SLSI.bin /vendor/firmware/AP_AUDIO_SLSI.bin bind
    mount none /vendor/firmware/SM-A256B/APDV_AUDIO_SLSI.bin /vendor/firmware/APDV_AUDIO_SLSI.bin bind
    mount none /vendor/firmware/SM-A256B/mfc_fw.bin /vendor/firmware/mfc_fw.bin bind
    mount none /vendor/firmware/SM-A256B/NPU.bin /vendor/firmware/NPU.bin bind
    mount none /vendor/firmware/SM-A256B/os.checked.bin /vendor/firmware/os.checked.bin bind
    mount none /vendor/firmware/SM-A256B/vts.bin /vendor/firmware/vts.bin bind
    mount none /vendor/firmware/SM-A256B/calliope_sram.bin /vendor/firmware/calliope_sram.bin bind
    # TEEgris
    mount none /vendor/tee/SM-A256B /vendor/tee bind

# a25xdxx (swa_open)
on early-init && property:ro.boot.em.model=SM-A256E
    # Firmware blobs
    mount none /vendor/firmware/SM-A256E/AP_AUDIO_SLSI.bin /vendor/firmware/AP_AUDIO_SLSI.bin bind
    mount none /vendor/firmware/SM-A256E/APDV_AUDIO_SLSI.bin /vendor/firmware/APDV_AUDIO_SLSI.bin bind
    mount none /vendor/firmware/SM-A256E/mfc_fw.bin /vendor/firmware/mfc_fw.bin bind
    mount none /vendor/firmware/SM-A256E/NPU.bin /vendor/firmware/NPU.bin bind
    mount none /vendor/firmware/SM-A256E/os.checked.bin /vendor/firmware/os.checked.bin bind
    mount none /vendor/firmware/SM-A256E/vts.bin /vendor/firmware/vts.bin bind
    mount none /vendor/firmware/SM-A256E/calliope_sram.bin /vendor/firmware/calliope_sram.bin bind
    # TEEgris
    mount none /vendor/tee/SM-A256E /vendor/tee bind

# Restart just to be safe.
on boot
    restart audioserver
